# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
GOOGLE_PLACES_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# Report email: competition address copied on every report (empty = none)
REPORT_RECIPIENT=
# Public URL of the deployed backend; needed for the call recording link in the report
APP_PUBLIC_BASE_URL=
# Report email subjects (with / without a confirmed-available option); empty = default
APP_REPORT_SUBJECT=
APP_REPORT_SUBJECT_UNCONFIRMED=
# Report email over SMTP instead of Resend: APP_EMAIL_TRANSPORT=smtp (Gmail: smtp.gmail.com, 587, an app password)
APP_EMAIL_TRANSPORT=resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Team sign-off at the end of every report; empty = defaults ("Team 5" and the three members)
APP_REPORT_TEAM_NAME=
APP_REPORT_TEAM_MEMBERS=
